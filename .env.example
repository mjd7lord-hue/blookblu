NODE_ENV=development
PORT=3000

# Supabase → Connect → Connection string
# اپ: Transaction pooler (پورت 6543) — migration: Session pooler (پورت 5432) در DIRECT_URL
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DB_SSL=true

# دو رشتهٔ تصادفی طولانی: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_DAYS=60

OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5
# فقط توسعه؛ کد OTP را در پاسخ API برمی‌گرداند
OTP_DEV_ECHO=false

# console | kavenegar | melipayamak
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=block-otp
KAVENEGAR_SIGN_TEMPLATE=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_BODY_ID=
# الگوی جدا برای کد امضای قرارداد (اختیاری؛ اگر خالی، همان الگوی ورود)
MELIPAYAMAK_SIGN_BODY_ID=

# آدرس‌های مجاز فرانت، با کاما جدا؛ * یعنی همه
CORS_ORIGINS=*

# ذخیرهٔ فایل — auto (پیش‌فرض): اگر کلید Supabase باشد supabase، وگرنه local (پوشهٔ uploads)
STORAGE_DRIVER=auto
# Supabase → Project Settings → API Keys → service_role / Secret key (مخفی؛ هرگز در فرانت)
# SUPABASE_URL لازم نیست؛ از DATABASE_URL ساخته می‌شود
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=blook-files
STORAGE_LOCAL_DIR=./uploads
# برای آینده (لیارا یا هر S3): STORAGE_DRIVER=s3 و این‌ها
S3_ENDPOINT=
S3_REGION=default
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# اعتبار لینک فایل‌های خصوصی (ثانیه)
FILE_URL_TTL_SECONDS=3600
# آدرس عمومی API تا لینک فایل‌ها کامل باشند (اختیاری)
PUBLIC_BASE_URL=
