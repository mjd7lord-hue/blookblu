NODE_ENV=development
PORT=3000

# Supabase → Project Settings → Database → Connection string (URI)
# از «Session pooler» (پورت 5432) استفاده کن
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DB_SSL=true

# دو رشتهٔ تصادفی طولانی (مثلاً با: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_DAYS=60

OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5
# فقط برای توسعه؛ کد را در پاسخ API برمی‌گرداند
OTP_DEV_ECHO=true

# console | kavenegar | melipayamak
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=block-otp
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_BODY_ID=

# آدرس‌های مجاز فرانت، با کاما جدا؛ * یعنی همه
CORS_ORIGINS=*
