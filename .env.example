NODE_ENV=development
PORT=3000

# Supabase → Project Settings → Database → Connection string (URI) — یا PostgreSQL لیارا
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_SSL=true

# دو رشتهٔ تصادفی طولانی: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_DAYS=60

OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5
# فقط توسعه؛ کد OTP را در پاسخ API برمی‌گرداند
OTP_DEV_ECHO=false

# console | kavenegar | melipayamak
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=block-otp
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_BODY_ID=

# آدرس‌های مجاز فرانت، با کاما جدا؛ * یعنی همه
CORS_ORIGINS=*

# ذخیرهٔ فایل — local برای توسعه، s3 برای سرور (Object Storage لیارا)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# لیارا → ذخیره‌سازی ابری → باکت (خصوصی) → کلیدهای دسترسی
S3_ENDPOINT=https://storage.iran.liara.space
S3_REGION=default
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# اعتبار لینک فایل‌های خصوصی (ثانیه)
FILE_URL_TTL_SECONDS=3600
# آدرس عمومی API تا لینک فایل‌ها کامل باشند (اختیاری)، مثلاً https://blookblu.liara.run
PUBLIC_BASE_URL=
